# Copy to .env.local for local development. Never commit real values.

# Server-only: where the storefront's server reaches the catalog API (no trailing slash, no /api/v1).
# Not NEXT_PUBLIC_*: the browser never calls the API directly. Read at request time, not needed by `npm run build`.
# Defaults to http://localhost:5167 in `npm run dev` only; required in production.
API_BASE_URL=http://localhost:5167

# Public origin of the storefront (canonical URLs, sitemap, JSON-LD), no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: shared secret sent as X-Storefront-Key on every cart / checkout / order call. Must equal the API's
# Storefront:ApiKey (>= 32 random characters in production). In `npm run dev` it defaults to the API's development key.
STOREFRONT_API_KEY=

# Server-only: number of trusted reverse proxies in front of Next.js (each appends the address of its peer to
# X-Forwarded-For). 0 = none: the header is ignored (trusted only in `npm run dev`). Required (>= 1) in production,
# otherwise every visitor shares one IP and its rate limits. The API must list this server in Storefront:TrustedProxies.
TRUSTED_PROXY_HOPS=0

# Server-only: key that seals the admin session cookie (>= 32 random bytes). REQUIRED in production (the server refuses to
# start without it or with a placeholder); development falls back to a built-in dev key.
ADMIN_SESSION_SECRET=
# Admin session limits (defaults 60 minutes idle, 8 hours absolute).
ADMIN_SESSION_IDLE_MINUTES=60
ADMIN_SESSION_ABSOLUTE_HOURS=8
