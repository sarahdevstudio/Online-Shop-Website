<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>shop-mvp-api-6b0c2f4e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Shop.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Shop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- import-initial-catalog (ImportInitialCatalogCommand) reads these next to the built dll. The manifest is a
         default Content item, the images are default None items; both need CopyToOutputDirectory. -->
    <Content Update="SeedData\initial-catalog\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="SeedData\initial-catalog\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- import-initial-content (ImportInitialContentCommand) reads these next to the built dll. -->
    <Content Update="SeedData\initial-content\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="SeedData\initial-content\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
