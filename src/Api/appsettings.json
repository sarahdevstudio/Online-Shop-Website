{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "RequireSecureCookie": true
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
